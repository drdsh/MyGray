{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mygray/requirements.schema.json",
  "title": "MyGray requirements & traceability model",
  "description": "Single source of truth for user needs, system & software requirements, hazards and risk controls. Feeds the SRS (IEC 62304 §5.2), risk file (ISO 14971), GSPR checklist (MDR Annex I) and the trace matrix generated by `cargo xtask trace`.",
  "type": "object",
  "required": ["document", "product", "user_needs", "system_requirements", "software_requirements", "hazards", "risk_controls"],
  "$defs": {
    "id": { "type": "string", "pattern": "^(UN|SYS|SRS|HAZ|RC)-([A-Z]{2,5}-)?[0-9]{3}$" },
    "status": { "enum": ["draft", "reviewed", "approved", "implemented", "verified", "obsolete"] },
    "verification_method": { "enum": ["unit_test", "integration_test", "system_test", "fuzz_test", "benchmark", "inspection", "analysis", "usability_test", "penetration_test"] },
    "software_item": { "enum": ["SI-01", "SI-02", "SI-03", "SI-04", "SI-05", "SI-06", "SI-07", "SI-08"] },
    "category": { "enum": ["functional", "performance", "safety", "security", "privacy", "data_integrity", "interface", "usability", "regulatory", "maintainability", "installation"] },
    "priority": { "enum": ["must", "should", "could"] },
    "requirement": {
      "type": "object",
      "required": ["id", "title", "statement", "category", "priority", "status", "verification"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "maxLength": 120 },
        "statement": { "type": "string", "description": "Atomic, verifiable 'shall' statement." },
        "rationale": { "type": "string" },
        "category": { "$ref": "#/$defs/category" },
        "priority": { "$ref": "#/$defs/priority" },
        "status": { "$ref": "#/$defs/status" },
        "derived_from": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "software_items": { "type": "array", "items": { "$ref": "#/$defs/software_item" } },
        "implements_risk_controls": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "gspr": { "type": "array", "items": { "type": "string", "description": "MDR Annex I clause, e.g. '17.2'" } },
        "standards": { "type": "array", "items": { "type": "string" } },
        "acceptance_criteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "verification": {
          "type": "object",
          "required": ["method"],
          "properties": {
            "method": { "type": "array", "items": { "$ref": "#/$defs/verification_method" }, "minItems": 1 },
            "tests": { "type": "array", "items": { "type": "string" }, "description": "Test function names or test-plan ids. Filled/checked by `cargo xtask trace`." }
          }
        }
      }
    }
  },
  "properties": {
    "document": {
      "type": "object",
      "required": ["id", "title", "version", "status"],
      "properties": {
        "id": { "type": "string" }, "title": { "type": "string" }, "version": { "type": "string" },
        "status": { "$ref": "#/$defs/status" },
        "approvals": { "type": "array", "items": { "type": "object", "properties": { "role": { "type": "string" }, "name": { "type": "string" }, "date": { "type": "string", "format": "date" } } } },
        "change_history": { "type": "array" }
      }
    },
    "product": { "type": "object" },
    "software_items": { "type": "array" },
    "stakeholders": { "type": "array" },
    "user_needs": {
      "type": "array",
      "items": { "type": "object", "required": ["id", "statement"], "properties": { "id": { "$ref": "#/$defs/id" }, "statement": { "type": "string" }, "stakeholder": { "type": "string" }, "validation": { "type": "string" } } }
    },
    "system_requirements": { "type": "array", "items": { "$ref": "#/$defs/requirement" } },
    "software_requirements": { "type": "array", "items": { "$ref": "#/$defs/requirement" } },
    "hazards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "hazard", "hazardous_situation", "harm", "severity", "probability_before"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "hazard": { "type": "string" }, "sequence_of_events": { "type": "string" },
          "hazardous_situation": { "type": "string" }, "harm": { "type": "string" },
          "severity": { "enum": ["S1-negligible", "S2-minor", "S3-serious", "S4-critical", "S5-catastrophic"] },
          "probability_before": { "enum": ["P1-improbable", "P2-remote", "P3-occasional", "P4-probable", "P5-frequent"] },
          "probability_after": { "enum": ["P1-improbable", "P2-remote", "P3-occasional", "P4-probable", "P5-frequent"] },
          "risk_controls": { "type": "array", "items": { "$ref": "#/$defs/id" } },
          "residual_risk_acceptable": { "type": "boolean" }
        }
      }
    },
    "risk_controls": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "description", "type"],
        "properties": {
          "id": { "$ref": "#/$defs/id" }, "description": { "type": "string" },
          "type": { "enum": ["inherent_safety_by_design", "protective_measure", "information_for_safety"] },
          "implemented_by": { "type": "array", "items": { "$ref": "#/$defs/id" } }
        }
      }
    }
  }
}
